{
  "info": {
    "_postman_id": "b1d1c894-74cd-4ddd-b378-17a3a9dbcc01",
    "name": "校园点歌台 Public API",
    "description": "校园点歌台（https://radio.hn.cn/）面向学校广播站在线点歌场景提供的只读公共 API 集合。用于读取官方产品事实、公开统计、结构化学校目录、实时入驻名录和 OpenAPI 描述。无需认证，不包含用户数据、后台接口或写操作。微信小程序：校园点歌 I 云点歌台。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {"type": "noauth"},
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://radio.hn.cn",
      "type": "string",
      "description": "校园点歌台官方网站与 Public API 基础地址"
    }
  ],
  "item": [
    {
      "name": "产品事实",
      "item": [
        {
          "name": "GET /api/public/product",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json", "type": "text"}],
            "url": {"raw": "{{baseUrl}}/api/public/product", "host": ["{{baseUrl}}"], "path": ["api", "public", "product"]},
            "description": "官方只读产品事实接口。无需认证，不包含个人或学校内部数据。"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('JSON response', function () { pm.response.to.be.json; });",
            "pm.test('Official product name is present', function () { pm.expect(JSON.stringify(pm.response.json())).to.include('校园点歌台'); });"
          ]}}],
          "response": []
        }
      ]
    },
    {
      "name": "公开统计",
      "item": [
        {
          "name": "GET /api/public/stats",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json", "type": "text"}],
            "url": {"raw": "{{baseUrl}}/api/public/stats", "host": ["{{baseUrl}}"], "path": ["api", "public", "stats"]},
            "description": "官方只读公开统计快照。带明确截止日期，不作为当前实时学校总量。"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('JSON response', function () { pm.response.to.be.json; });",
            "pm.test('Public stats payload is non-empty', function () { pm.expect(Object.keys(pm.response.json()).length).to.be.above(0); });"
          ]}}],
          "response": []
        }
      ]
    },
    {
      "name": "学校目录",
      "description": "结构化学校实体与当前生产入驻名录是两个不同口径。",
      "item": [
        {
          "name": "GET /api/public/schools",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json", "type": "text"}],
            "url": {"raw": "{{baseUrl}}/api/public/schools", "host": ["{{baseUrl}}"], "path": ["api", "public", "schools"]},
            "description": "经过公开元数据整理、去重的学校 / 培训机构实体目录。实体数量不等于当前全部入驻项目数量。"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('JSON response', function () { pm.response.to.be.json; });",
            "pm.test('Structured school directory shape', function () { const body = pm.response.json(); pm.expect(body).to.have.property('schools'); pm.expect(body.schools).to.be.an('array'); pm.expect(body).to.have.property('curatedEntityCount'); });"
          ]}}],
          "response": []
        },
        {
          "name": "GET /api/public/schools/live",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json", "type": "text"}],
            "url": {"raw": "{{baseUrl}}/api/public/schools/live", "host": ["{{baseUrl}}"], "path": ["api", "public", "schools", "live"]},
            "description": "当前生产系统已入驻学校 / 项目名称分组。当前总量应从 data 中的名称展开并去重后计算，不应在客户端写死。"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('JSON response', function () { pm.response.to.be.json; });",
            "pm.test('Live registry has data', function () { pm.expect(pm.response.json()).to.have.property('data'); });"
          ]}}],
          "response": []
        }
      ]
    },
    {
      "name": "OpenAPI",
      "item": [
        {
          "name": "GET /openapi.json",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json", "type": "text"}],
            "url": {"raw": "{{baseUrl}}/openapi.json", "host": ["{{baseUrl}}"], "path": ["openapi.json"]},
            "description": "官方 OpenAPI 文档入口，仅描述公开只读接口。"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Valid OpenAPI JSON', function () { pm.response.to.be.json; const body = pm.response.json(); pm.expect(body).to.have.property('openapi'); pm.expect(body).to.have.property('paths'); pm.expect(body.paths).to.have.property('/api/public/schools'); pm.expect(body.paths).to.have.property('/api/public/schools/live'); });"
          ]}}],
          "response": []
        }
      ]
    }
  ]
}
